# Copy to .env

# Postgres. Local: `docker compose up -d` then use the line below.
# Hosted: paste the connection string from Neon / Supabase / Vercel Postgres.
DATABASE_URL="postgresql://draftmap:draftmap@localhost:5432/draftmap"

# Used to sign session cookies. Any long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional. Nominatim requires a real contact in the User-Agent.
GEOCODER_USER_AGENT="draft-map-dev (you@example.com)"

# Stripe (pub subscriptions). Leave blank to run in demo mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Ads. Leave blank to render placeholder slots.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Board-photo reading (chalkboard OCR). Leave blank to disable the feature.
ANTHROPIC_API_KEY=""

# Identify the menu/photo importers to the sites they visit.
IMPORT_USER_AGENT="DraftMapBot/0.1 (+https://yourdomain.example/bot; contact: you@example.com)"

# Optional: web search for pubs with no website on record (Brave Search API).
BRAVE_SEARCH_API_KEY=""
